{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/**": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@electric-sql/pglite/dist/**"
    }
  },
  "env": {
    "DOMAIN": "social"
  }
}
